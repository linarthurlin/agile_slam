<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface name="eth0" multicast="true"/></Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <!-- Keep DDS UDP payloads below the 1500-byte Docker bridge MTU. -->
      <MaxMessageSize>1400B</MaxMessageSize><FragmentSize>1280B</FragmentSize>
    </General>
    <Discovery><ParticipantIndex>auto</ParticipantIndex><MaxAutoParticipantIndex>64</MaxAutoParticipantIndex></Discovery>
  </Domain>
</CycloneDDS>
